#!/usr/bin/env php
<?php

declare(strict_types=1);

use Dujana\ArabicNlp\Console\Standalone\BuildLexiconStandaloneCommand;
use Symfony\Component\Console\Application;

require __DIR__.'/../vendor/autoload.php';

$application = new Application('Dujana Arabic NLP', '1.0.0');
$application->add(new BuildLexiconStandaloneCommand());
$application->setDefaultCommand('build', true);

exit($application->run());